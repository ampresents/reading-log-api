{
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write",
        "hooks": [{ "type": "command",
          "command": "\"E:/reading-log-api/.venv/Scripts/python.exe\" \"E:/reading-log-api/.claude/hooks/format.py\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|Bash",
        "hooks": [{ "type": "command",
          "command": "\"E:/reading-log-api/.venv/Scripts/python.exe\" \"E:/reading-log-api/.claude/hooks/protect_files.py\"" }] },
      { "matcher": "mcp__sqlite__write_query|mcp__sqlite__create_table",
        "hooks": [{ "type": "command",
          "command": "\"E:/reading-log-api/.venv/Scripts/python.exe\" \"E:/reading-log-api/.claude/hooks/block_db_write.py\"" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command",
          "command": "\"E:/reading-log-api/.venv/Scripts/python.exe\" \"E:/reading-log-api/.claude/hooks/run_tests.py\"" }] }
    ]
  }
}
